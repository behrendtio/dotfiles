{
  "lastChangelogVersion": "0.84.4",
  "theme": "catppuccin-latte/catppuccin-mocha",
  "packages": [
    "~/Code/pi-statusbar-mario",
    "npm:pi-xai-oauth",
    "npm:pi-mcp-adapter",
    "git:github.com/otahontas/pi-coding-agent-catppuccin",
    "npm:pi-autoresearch",
    "npm:@zigai/pi-mention-skill",
    "npm:pi-web-access",
    "git:github.com/algal/pi-openai-server-compaction",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "hideThinkingBlock": true,
  "editorPaddingX": 1,
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
  "quietStartup": true,
  "collapseChangelog": true,
  "defaultProjectTrust": "always",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-luna",
    "xai-auth/grok-4.7"
  ],
  "compaction": {
    "enabled": true
  },
  "skillful": {
    "hiddenSkills": []
  },
  "tuiMode": "fullscreen"
}