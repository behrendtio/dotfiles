{
  "lastChangelogVersion": "0.83.0",
  "theme": "catppuccin-latte/catppuccin-mocha",
  "packages": [
    "../../Code/pi-statusbar-mario",
    "npm:pi-pr-status",
    "npm:pi-xai",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "git:github.com/otahontas/pi-coding-agent-catppuccin",
    "npm:@diegopetrucci/pi-openai-fast",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-autoresearch",
    "npm:@narumitw/pi-btw",
    "npm:@zigai/pi-mention-skill",
    "npm:@zigai/pi-message-highlights"
  ],
  "defaultProvider": "grok-build",
  "defaultModel": "grok-4.5",
  "hideThinkingBlock": true,
  "editorPaddingX": 1,
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "one-at-a-time",
  "quietStartup": true,
  "collapseChangelog": true,
  "defaultProjectTrust": "always",
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "grok-build/grok-4.5",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra"
  ],
  "compaction": {
    "enabled": true
  },
  "skillful": {
    "hiddenSkills": []
  }
}