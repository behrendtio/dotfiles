# Fonts
#font-family = "Hack Nerd Font Mono"
font-family = "Hack"
font-size = 13
#font-thicken = true

# Window
#window-padding-x = 12
#window-padding-y = 12
window-subtitle=false
macos-titlebar-proxy-icon=hidden
macos-titlebar-style=tabs
#title=" "
background-blur-radius = 20
cursor-style-blink = true
adjust-cell-height = 2
#background-opacity = 0.9
shell-integration-features = no-cursor,no-title
cursor-style = block
#cursor-opacity = 0.8
unfocused-split-opacity = 1

#theme = "dracula"
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Behaviour
mouse-hide-while-typing = true
window-save-state = always
window-theme = auto

# Quick terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# Keyboard shortcuts
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+g=toggle_quick_terminal

# Free for Herdr workspace/agent prev/next (see ~/.config/herdr/config.toml)
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+[=unbind
keybind = super+]=unbind

# Allow (right) Alt to come through (for Codex reasoning effort changes)
macos-option-as-alt = true
