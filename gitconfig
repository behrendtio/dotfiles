[user]
    name = Mario Behrendt
    email = 251007+behrendtio@users.noreply.github.com
[core]
    autocrlf = input
    editor = /usr/bin/nvim
    excludesfile = ~/.gitignore
    pager = less
[color]
    ui = auto
[branch "master"]
    remote = origin
    merge = refs/heads/master
[push]
    default = current
[pull]
    rebase = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
